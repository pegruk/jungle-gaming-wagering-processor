{
  "uid": "wagering",
  "title": "Wagering Processor",
  "schemaVersion": 40,
  "version": 1,
  "refresh": "5s",
  "time": { "from": "now-15m", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Transactions by status / second",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status) (rate(wagering_transactions_total[1m]))",
          "legendFormat": "{{status}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "Processing latency p50 / p95 / p99 (seconds)",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.50,sum by (le) (rate(wagering_processing_duration_seconds_bucket[1m])))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95,sum by (le) (rate(wagering_processing_duration_seconds_bucket[1m])))",
          "legendFormat": "p95"
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.99,sum by (le) (rate(wagering_processing_duration_seconds_bucket[1m])))",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "id": 3,
      "title": "Oldest pending event (seconds)",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "wagering_outbox_lag_seconds" }]
    },
    {
      "id": 4,
      "title": "Unpublished events",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "refId": "A", "expr": "wagering_outbox_lag_total" }]
    },
    {
      "id": 5,
      "title": "Duplicates / retries / DLQ / lock conflicts",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 16, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(wagering_duplicates_total[1m])",
          "legendFormat": "duplicates"
        },
        {
          "refId": "B",
          "expr": "sum(rate(wagering_retries_total[1m]))",
          "legendFormat": "retries"
        },
        { "refId": "C", "expr": "rate(wagering_dlq_total[1m])", "legendFormat": "DLQ" },
        {
          "refId": "D",
          "expr": "rate(wagering_lock_conflicts_total[1m])",
          "legendFormat": "lock conflicts"
        }
      ]
    },
    {
      "id": 6,
      "title": "Wallet lock wait p95 (seconds)",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 16, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95,sum by (le) (rate(wagering_wallet_lock_wait_seconds_bucket[1m])))"
        }
      ]
    }
  ]
}
